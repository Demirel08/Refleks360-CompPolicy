@using Refleks360.Domain.Security

<div class="nav-scrollable">
    <div class="brand">
        <span class="brand-icon">R360</span>
        <div>
            <div class="brand-name">Refleks 360</div>
            <div class="brand-sub">Ücret Politikası</div>
        </div>
    </div>

    <nav class="nav flex-column">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-grid-1x2"></i> Genel Bakış
        </NavLink>

        <AuthorizeView Policy="@Permissions.EmployeeView">
            <NavLink class="nav-link" href="calisanlar">
                <i class="bi bi-people"></i> Çalışanlar
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.ScenarioView">
            <NavLink class="nav-link" href="senaryolar">
                <i class="bi bi-layers"></i> Senaryolar
            </NavLink>
            <NavLink class="nav-link" href="simulasyon">
                <i class="bi bi-arrow-left-right"></i> Simülasyon
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.ReportView">
            <NavLink class="nav-link" href="raporlar">
                <i class="bi bi-file-earmark-bar-graph"></i> Raporlar
            </NavLink>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="onaylarim">
                    <i class="bi bi-inbox"></i> Onaylarım
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <NavLink class="nav-link" href="hesaplama">
            <i class="bi bi-calculator"></i> Maaş Hesaplama
        </NavLink>

        <AuthorizeView Policy="@Permissions.BandView">
            <div class="nav-group">
                <div class="nav-group-label">Analiz</div>
                <NavLink class="nav-link" href="admin/comp-policy">
                    <i class="bi bi-bar-chart"></i> Comp Policy
                </NavLink>
                <NavLink class="nav-link" href="admin/pay-equity">
                    <i class="bi bi-gender-ambiguous"></i> Pay Equity
                </NavLink>
                <NavLink class="nav-link" href="admin/benchmark">
                    <i class="bi bi-bullseye"></i> Benchmark
                </NavLink>
                <NavLink class="nav-link" href="admin/heatmap">
                    <i class="bi bi-grid-3x3"></i> Heat Map
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.ReportView">
            <NavLink class="nav-link" href="admin/multi-year">
                <i class="bi bi-calendar3"></i> Çok Yıllı Plan
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.OrgEdit">
            <div class="nav-group">
                <div class="nav-group-label">Yönetim</div>
                <NavLink class="nav-link" href="admin/organizasyon">
                    <i class="bi bi-diagram-3"></i> Organizasyon
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.BandEdit">
            <NavLink class="nav-link" href="admin/bantlar">
                <i class="bi bi-rulers"></i> Maaş Bantları
            </NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.TaxParameterView">
            <NavLink class="nav-link" href="admin/vergi">
                <i class="bi bi-receipt"></i> Vergi Parametreleri
            </NavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Settings">
            <NavLink class="nav-link" href="admin/onay-sablonlari">
                <i class="bi bi-list-check"></i> Onay Şablonları
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.AuditView">
            <div class="nav-group">
                <div class="nav-group-label">Sistem</div>
                <NavLink class="nav-link" href="admin/audit">
                    <i class="bi bi-journal-text"></i> Audit Log
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.Settings">
            <NavLink class="nav-link" href="admin/yedek">
                <i class="bi bi-archive"></i> Yedekleme
            </NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="@Roles.SystemAdmin">
            <a class="nav-link" href="/hangfire" target="_blank">
                <i class="bi bi-cpu"></i> Hangfire <i class="bi bi-arrow-up-right" style="font-size:0.65rem;"></i>
            </a>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.UserManage">
            <NavLink class="nav-link" href="admin/kullanicilar">
                <i class="bi bi-person-gear"></i> Kullanıcılar
            </NavLink>
        </AuthorizeView>
    </nav>

    <div class="footer-version">v3.0.0 · @DateTime.Now.Year</div>
</div>
