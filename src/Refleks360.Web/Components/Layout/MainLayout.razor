@inherits LayoutComponentBase
@inject Refleks360.Application.Abstractions.ICurrentCompanyContext CompanyCtx
@inject NavigationManager NavMgr

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized Context="auth">
                        @if (_companies is not null && _companies.Count > 1)
                        {
                            <form method="post" action="/company/switch" class="m-0 d-flex align-items-center gap-2">
                                <input type="hidden" name="returnUrl" value="@NavMgr.Uri" />
                                <span class="text-muted small" style="text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Şirket</span>
                                <select name="companyId" class="form-select form-select-sm" style="width:auto; min-width:220px;" onchange="this.form.submit()">
                                    @foreach (var c in _companies)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == _currentId)">@c.Name</option>
                                    }
                                </select>
                            </form>
                        }
                    </Authorized>
                    <NotAuthorized><span></span></NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized Context="auth2">
                        <span class="user-badge">
                            <span class="avatar">@GetInitials(auth2.User.Identity?.Name)</span>
                            <span>@auth2.User.Identity?.Name</span>
                        </span>
                        <form method="post" action="/auth/logout" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Çıkış">
                                <i class="bi bi-box-arrow-right"></i> Çıkış
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-primary" href="/login">Giriş</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmedik bir hata oluştu.
    <a href="." class="reload">Sayfayı yenile</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private IReadOnlyList<Refleks360.Application.Abstractions.CompanyOption>? _companies;
    private int _currentId;

    protected override async Task OnInitializedAsync()
    {
        _currentId = CompanyCtx.CurrentCompanyId;
        _companies = await CompanyCtx.GetAccessibleCompaniesAsync();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(new[] { ' ', '.', '@' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }
}
