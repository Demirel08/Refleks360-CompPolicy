@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Refleks360.Application.Abstractions
@using Refleks360.Application.Dashboards
@using Syncfusion.Blazor.Charts
@inject IDashboardService Dash

<PageTitle>Refleks 360 ÜP — Dashboard</PageTitle>

<h1 class="mb-3">Dashboard</h1>

@if (_data is null) { <p>Yükleniyor...</p> }
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-2"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Toplam Çalışan</div>
            <div class="h3 mb-0">@_data.TotalEmployees</div>
            <div class="small text-muted">@_data.ActiveEmployees aktif</div>
        </div></div></div>
        <div class="col-md-3"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Aylık İşveren Yükü</div>
            <div class="h3 mb-0">@_data.MonthlyEmployerCostTotal.ToString("N0") ₺</div>
        </div></div></div>
        <div class="col-md-2"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Ort. Compa-Ratio</div>
            <div class="h3 mb-0">@_data.AvgCompaRatio.ToString("F2")</div>
        </div></div></div>
        <div class="col-md-2"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Onay Bekleyen</div>
            <div class="h3 mb-0">@_data.PendingScenarios</div>
            <div class="small text-muted">senaryo</div>
        </div></div></div>
        <div class="col-md-3"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Ham Cinsiyet Pay Gap</div>
            <div class="h3 mb-0 @(_data.PayGap.RawGapPercent > 0 ? "text-warning" : "text-success")">@_data.PayGap.RawGapPercent.ToString("F1")%</div>
            <div class="small text-muted">E: @_data.PayGap.AvgMaleGross.ToString("N0") / K: @_data.PayGap.AvgFemaleGross.ToString("N0")</div>
        </div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-md-7">
            <div class="card"><div class="card-body">
                <h2 class="h6">Departman Bazlı Aylık Maliyet</h2>
                <SfChart Title="" Height="320">
                    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" LabelRotation="-30" />
                    <ChartPrimaryYAxis Title="₺" LabelFormat="N0" />
                    <ChartSeriesCollection>
                        <ChartSeries DataSource="@_data.CostByDepartment"
                                     XName="@nameof(DepartmentCostSlice.Department)"
                                     YName="@nameof(DepartmentCostSlice.MonthlyEmployerCost)"
                                     Type="ChartSeriesType.Column"
                                     Name="Aylık ₺" />
                    </ChartSeriesCollection>
                </SfChart>
            </div></div>
        </div>
        <div class="col-md-5">
            <div class="card"><div class="card-body">
                <h2 class="h6">Hızlı Geçiş</h2>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary" href="/calisanlar">→ Çalışan Listesi</a>
                    <a class="btn btn-outline-primary" href="/senaryolar">→ Senaryolar</a>
                    <a class="btn btn-outline-primary" href="/admin/comp-policy">→ Comp Policy Metrikleri</a>
                    <a class="btn btn-outline-primary" href="/simulasyon">→ İşe Alım/Çıkış Simülasyonu</a>
                    <a class="btn btn-outline-primary" href="/admin/bantlar">→ Maaş Bantları</a>
                    <a class="btn btn-outline-primary" href="/hesaplama">→ Maaş Hesaplama (tek kişi)</a>
                </div>
            </div></div>
        </div>
    </div>
}

@code {
    private DashboardSummary? _data;
    protected override async Task OnInitializedAsync() => _data = await Dash.GetSummaryAsync();
}
