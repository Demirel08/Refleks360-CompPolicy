@page "/simulasyon"
@attribute [Authorize(Policy = Permissions.ScenarioView)]
@rendermode InteractiveServer
@using Refleks360.Application.Abstractions
@using Refleks360.Application.Simulation
@using Refleks360.Domain.Security
@inject ISimulationService Sim
@inject IOrganizationLookupService Lookup

<PageTitle>Simülasyon</PageTitle>

<h1>İşe Alım / Ayrılış Simülasyonu</h1>
<p class="text-muted small">
    Birden fazla yeni alım ve ayrılış senaryosu tanımla; aylık + yıllık işveren maliyeti farkı +
    kıdem tazminatı yükümlülüğü tahmini anlık hesaplanır.
</p>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <h2 class="h6 d-flex justify-content-between">Yeni İşe Alımlar
                <button class="btn btn-sm btn-outline-primary" @onclick="AddHire">+ Ekle</button></h2>
            @foreach (var h in _hires)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="row g-2">
                        <div class="col-md-6"><input class="form-control form-control-sm" placeholder="Etiket" @bind="h.Label" /></div>
                        <div class="col-md-3"><input type="number" class="form-control form-control-sm" placeholder="Aylık brüt" @bind="h.MonthlyGross" /></div>
                        <div class="col-md-3"><input type="date" class="form-control form-control-sm" @bind="h.StartDate" /></div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="h.PositionId">
                                <option value="0">— pozisyon —</option>
                                @foreach (var p in _positions) { <option value="@p.Id">@p.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="h.DepartmentId">
                                <option value="0">— departman —</option>
                                @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="h.LocationId">
                                <option value="0">— lokasyon —</option>
                                @foreach (var l in _locations) { <option value="@l.Id">@l.Name</option> }
                            </select>
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="@(() => _hires.Remove(h))">kaldır</button>
                    </div>
                </div>
            }
        </div></div>
    </div>

    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <h2 class="h6 d-flex justify-content-between">Ayrılışlar
                <button class="btn btn-sm btn-outline-primary" @onclick="AddLeave">+ Ekle</button></h2>
            @foreach (var d in _leaves)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="row g-2">
                        <div class="col-md-7">
                            <select class="form-select form-select-sm" @bind="d.EmployeeId">
                                <option value="0">— çalışan —</option>
                                @foreach (var m in _managers) { <option value="@m.Id">@m.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><input type="date" class="form-control form-control-sm" @bind="d.TerminationDate" /></div>
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="@(() => _leaves.Remove(d))">kaldır</button>
                    </div>
                </div>
            }
        </div></div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <button class="btn btn-primary" @onclick="Run" disabled="@_busy">Simüle Et</button>
    @if (_error is not null) { <span class="text-danger align-self-center">@_error</span> }
</div>

@if (_result is not null)
{
    <div class="row g-3 mt-3">
        <div class="col-md-4"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Aylık İşveren Mal. Δ</div>
            <div class="h4 mb-0 @(_result.TotalMonthlyDelta >= 0 ? "text-danger" : "text-success")">@_result.TotalMonthlyDelta.ToString("+#,0;-#,0;0") ₺</div>
        </div></div></div>
        <div class="col-md-4"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Yıllık İşveren Mal. Δ</div>
            <div class="h4 mb-0 @(_result.TotalAnnualDelta >= 0 ? "text-danger" : "text-success")">@_result.TotalAnnualDelta.ToString("+#,0;-#,0;0") ₺</div>
        </div></div></div>
        <div class="col-md-4"><div class="card text-center"><div class="card-body">
            <div class="text-muted small">Toplam Kıdem Tazminatı</div>
            <div class="h4 mb-0 text-warning">@_result.TotalSeveranceLiability.ToString("N0") ₺</div>
        </div></div></div>
    </div>

    <table class="table table-sm mt-3">
        <thead><tr><th>Açıklama</th><th>Tip</th><th class="text-end">Aylık Δ</th><th class="text-end">Yıllık Δ</th><th class="text-end">Kıdem</th></tr></thead>
        <tbody>
            @foreach (var l in _result.Lines)
            {
                <tr>
                    <td>@l.Label</td>
                    <td>@(l.Kind == "hire" ? "İşe alım" : "Ayrılış")</td>
                    <td class="text-end">@l.MonthlyDelta.ToString("+#,0;-#,0;0")</td>
                    <td class="text-end">@l.AnnualDelta.ToString("+#,0;-#,0;0")</td>
                    <td class="text-end">@(l.SeveranceLiability > 0 ? l.SeveranceLiability.ToString("N0") : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<NewHireInput> _hires = new();
    private List<DepartureInput> _leaves = new();
    private SimulationResult? _result;
    private bool _busy;
    private string? _error;
    private IReadOnlyList<LookupItem> _positions = Array.Empty<LookupItem>();
    private IReadOnlyList<LookupItem> _departments = Array.Empty<LookupItem>();
    private IReadOnlyList<LookupItem> _locations = Array.Empty<LookupItem>();
    private IReadOnlyList<LookupItem> _managers = Array.Empty<LookupItem>();

    protected override async Task OnInitializedAsync()
    {
        _positions = await Lookup.GetPositionsAsync();
        _departments = await Lookup.GetDepartmentsAsync();
        _locations = await Lookup.GetLocationsAsync();
        _managers = await Lookup.GetManagerCandidatesAsync(null);
    }

    private void AddHire() => _hires.Add(new NewHireInput { MonthlyGross = 80_000m });
    private void AddLeave() => _leaves.Add(new DepartureInput());

    private async Task Run()
    {
        _busy = true; _error = null; _result = null;
        try
        {
            _result = await Sim.SimulateAsync(_hires, _leaves);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
